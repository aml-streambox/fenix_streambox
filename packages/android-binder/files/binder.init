#!/bin/sh
### BEGIN INIT INFO
# Provides:          binder
# Required-Start:    $local_fs $network
# Required-Stop:     $local_fs $network
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: binder servicemanager
# Description:       Android Binder IPC servicemanager
### END INIT INFO

# Starts binder service.
start() {
	printf "Starting binder service: \n"

	/usr/bin/binder.sh
	/usr/bin/servicemanager &
}

stop() {
	printf "Stopping binder service: \n"
	killall servicemanager 2>/dev/null || true
}

case "$1" in
  start)
	start
	;;
  stop)
	stop
	;;
  *)
	echo "Usage: $0 {start|stop}"
	exit 1
esac

exit $?

