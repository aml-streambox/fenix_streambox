#!/bin/sh
# Install the currently bootable, display-disabled kernel/DTB/initrd as the
# known-good recovery boot slot.

set -eu

MODE=refresh
ALLOW_DISPLAY=0

usage() {
	cat >&2 <<'EOF'
Usage: fenix-recovery-refresh [--init] [--force] [--allow-display-kernel]

  --init                  Create /boot/recovery only when it does not exist.
  --force                 Replace an existing /boot/recovery slot.
  --allow-display-kernel  Permit capturing a kernel config with local display
                          bring-up symbols enabled. This is intentionally off
                          by default so the recovery slot stays a basic image.
EOF
}

while [ "$#" -gt 0 ]; do
	case "$1" in
	--init)
		MODE=init
		;;
	--force)
		MODE=force
		;;
	--allow-display-kernel)
		ALLOW_DISPLAY=1
		;;
	-h|--help)
		usage
		exit 0
		;;
	*)
		usage
		exit 2
		;;
	esac
	shift
done

if [ "$MODE" = "init" ] && [ -f /boot/recovery/Image ]; then
	exit 0
fi

if [ "$MODE" = "refresh" ] && [ -f /boot/recovery/Image ]; then
	printf '%s\n' "Recovery slot already exists; use --force to replace it." >&2
	exit 1
fi

BOARD=""
if [ -r /etc/fenix-release ]; then
	# shellcheck disable=SC1091
	. /etc/fenix-release
	BOARD="${BOARD:-}"
fi

case "$BOARD" in
TVPRO)
	DTB_NAMES="t7_a311d2_tvpro4gdebian.dtb t7_a311d2_tvpro8gdebian.dtb t7c_a311d2_tvpro4gdebian.dtb t7c_a311d2_tvpro8gdebian.dtb"
	;;
VIM4)
	DTB_NAMES="amlogic-t7-a311d2-khadas-vim4.dtb"
	;;
*)
	printf 'Unsupported recovery board: %s\n' "${BOARD:-unknown}" >&2
	exit 1
	;;
esac

resolve_path() {
	if command -v readlink >/dev/null 2>&1; then
		readlink -f "$1" 2>/dev/null || true
	else
		printf '%s\n' "$1"
	fi
}

IMAGE_SRC=$(resolve_path /boot/Image)

[ -n "$IMAGE_SRC" ] && [ -f "$IMAGE_SRC" ] || { printf 'Missing /boot/Image target\n' >&2; exit 1; }
for dtb_name in $DTB_NAMES; do
	[ -f "/boot/dtb/amlogic/$dtb_name" ] || { printf 'Missing /boot/dtb/amlogic/%s target\n' "$dtb_name" >&2; exit 1; }
done

KERNEL_RELEASE=$(basename "$IMAGE_SRC" | sed 's/^vmlinuz-//')
CONFIG_SRC=/boot/config-$KERNEL_RELEASE

RECOVERY_CONF=/boot/extlinux/fenix-recovery.conf

recovery_blacklists_module() {
	[ -f "$RECOVERY_CONF" ] || return 1
	tr ' ' '\n' < "$RECOVERY_CONF" | sed -n 's/^module_blacklist=//p' | tr ',' '\n' | grep -qx "$1"
}

check_display_symbol() {
	sym=$1
	module=$2

	if grep -Eq "^${sym}=y$" "$CONFIG_SRC"; then
		printf 'Refusing to capture display-enabled recovery kernel: %s is built in %s\n' "$sym" "$CONFIG_SRC" >&2
		printf 'Install a basic display-disabled kernel first, or pass --allow-display-kernel for manual override.\n' >&2
		exit 1
	fi

	if grep -Eq "^${sym}=m$" "$CONFIG_SRC" && ! recovery_blacklists_module "$module"; then
		printf 'Refusing to capture recovery kernel: %s is modular but %s does not blacklist %s\n' "$sym" "$RECOVERY_CONF" "$module" >&2
		printf 'Add the recovery module_blacklist entry, or pass --allow-display-kernel for manual override.\n' >&2
		exit 1
	fi
}

if [ "$ALLOW_DISPLAY" -ne 1 ] && [ -f "$CONFIG_SRC" ]; then
	check_display_symbol CONFIG_DRM_MESON_T7_VENDOR meson_t7_vendor
	check_display_symbol CONFIG_AMLOGIC_COMMON_CLK_T7_DISPLAY t7_display_clkc
	check_display_symbol CONFIG_AMLOGIC_DRM aml_drm
	check_display_symbol CONFIG_AMLOGIC_MEDIA_MODULE aml_media
elif [ ! -f "$CONFIG_SRC" ]; then
	printf 'Warning: %s is missing; cannot verify display symbols.\n' "$CONFIG_SRC" >&2
fi

TMP=/boot/recovery.new.$$
OLD=/boot/recovery.previous

rm -rf "$TMP"
mkdir -p "$TMP/dtb/amlogic"

cp "$IMAGE_SRC" "$TMP/Image"
for dtb_name in $DTB_NAMES; do
	cp "/boot/dtb/amlogic/$dtb_name" "$TMP/dtb/amlogic/$dtb_name"
done
[ -f "$CONFIG_SRC" ] && cp "$CONFIG_SRC" "$TMP/config-$KERNEL_RELEASE"

if ! command -v fenix-build-recovery-initramfs >/dev/null 2>&1; then
	printf 'Missing fenix-build-recovery-initramfs\n' >&2
	exit 1
fi
fenix-build-recovery-initramfs --kernel-release "$KERNEL_RELEASE" --output "$TMP/initrd.img"

cat > "$TMP/manifest" <<EOF
board=$BOARD
kernel_release=$KERNEL_RELEASE
image_source=$IMAGE_SRC
initrd_source=ram-recovery-generated
dtb_sources=$DTB_NAMES
created_utc=$(date -u +%Y-%m-%dT%H:%M:%SZ)
display_override=$ALLOW_DISPLAY
EOF

rm -rf "$OLD"
if [ -d /boot/recovery ]; then
	mv /boot/recovery "$OLD"
fi
mv "$TMP" /boot/recovery
sync

printf 'Installed recovery slot for %s kernel %s\n' "$BOARD" "$KERNEL_RELEASE"
