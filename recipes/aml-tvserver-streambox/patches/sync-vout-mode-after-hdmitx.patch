+static void SynchronizeVoutMode(const char *mode_str)
+{
+    int ret;
+
+    if (mode_str == NULL || mode_str[0] == '\0') {
+        return;
+    }
+
+    /* Keep vout/video geometry in sync with direct HDMITX sysfs mode changes. */
+    WriteSysfs("/sys/class/display/debug", "1");
+    ret = WriteSysfs("/sys/class/display/mode", mode_str);
+    if (ret != 0) {
+        LOGD("%s: Failed to set vout mode to: %s (ret=%d)\n", __FUNCTION__, mode_str, ret);
+    } else {
+        LOGD("%s: Successfully set vout mode to: %s\n", __FUNCTION__, mode_str);
+    }
+    usleep(50000);
+    ret = WriteSysfs("/sys/class/video/axis", "0 0 0 0");
+    if (ret != 0) {
+        LOGD("%s: Failed to reset video axis (ret=%d)\n", __FUNCTION__, ret);
+    }
+    ret = WriteSysfs("/sys/class/video/video_zorder", "129");
+    if (ret != 0) {
+        LOGD("%s: Failed to raise video z-order (ret=%d)\n", __FUNCTION__, ret);
+    }
+    ret = WriteSysfs("/sys/class/video/force_property_change", "1");
+    if (ret != 0) {
+        LOGD("%s: Failed to force video property refresh (ret=%d)\n", __FUNCTION__, ret);
+    }
+    WriteSysfs("/sys/class/display/debug", "0");
+}
+
+static void ApplyHdmitxMode(const char *mode_str, int frac_rate_policy)
+{
+    int ret;
+    char frac_policy_str[16] = {0};
+    const char *hdmitx_disp_mode_path = "/sys/class/amhdmitx/amhdmitx0/disp_mode";
+    const char *hdmitx_frac_rate_policy_path = "/sys/class/amhdmitx/amhdmitx0/frac_rate_policy";
+
+    if (mode_str == NULL || mode_str[0] == '\0') {
+        return;
+    }
+
+    snprintf(frac_policy_str, sizeof(frac_policy_str), "%d", frac_rate_policy);
+    LOGD("%s: Setting frac_rate_policy to %d before setting disp_mode\n", __FUNCTION__, frac_rate_policy);
+    ret = WriteSysfs(hdmitx_frac_rate_policy_path, frac_policy_str);
+    if (ret != 0) {
+        LOGD("%s: Warning: Failed to set frac_rate_policy to %d (ret=%d), continuing anyway\n",
+             __FUNCTION__, frac_rate_policy, ret);
+    } else {
+        usleep(10000);
+    }
+
+    LOGD("%s: Disabling current hdmitx mode before setting new mode\n", __FUNCTION__);
+    ret = WriteSysfs(hdmitx_disp_mode_path, "off");
+    if (ret != 0) {
+        LOGD("%s: Warning: Failed to disable current hdmitx mode (ret=%d), continuing anyway\n", __FUNCTION__, ret);
+    } else {
+        usleep(50000);
+    }
+
+    ret = WriteSysfs(hdmitx_disp_mode_path, mode_str);
+    if (ret == 0) {
+        LOGD("%s: Successfully set hdmitx mode to: %s (with frac_rate_policy=%d)\n",
+             __FUNCTION__, mode_str, frac_rate_policy);
+        SynchronizeVoutMode(mode_str);
+    } else {
+        LOGD("%s: Failed to set hdmitx mode to: %s (ret=%d)\n", __FUNCTION__, mode_str, ret);
+    }
+}
+
+static void EnsureHdmitxMode(void)
+{
+    char display_mode[128] = {0};
+    char hdmitx_mode[1024] = {0};
+    int needs_restore = 0;
+
+    if (g_last_mode_str[0] == '\0') {
+        return;
+    }
+
+    if (ReadSysfs("/sys/class/display/mode", display_mode, sizeof(display_mode)) != 0 ||
+        strcmp(display_mode, g_last_mode_str) != 0) {
+        needs_restore = 1;
+    }
+
+    if (ReadSysfs("/sys/class/amhdmitx/amhdmitx0/disp_mode", hdmitx_mode, sizeof(hdmitx_mode)) != 0 ||
+        strstr(hdmitx_mode, g_last_mode_str) == NULL) {
+        needs_restore = 1;
+    }
+
+    if (needs_restore) {
+        LOGD("%s: Restoring hdmitx/vout mode to %s\n", __FUNCTION__, g_last_mode_str);
+        ApplyHdmitxMode(g_last_mode_str, g_last_frac_rate_policy);
+    }
+}
