{
  "schema": "fenix.recipe.v1",
  "name": "aml-tvserver-streambox",
  "version": "1.7.5+di2",
  "summary": "Amlogic TV Server Stream Box",
  "license": "Proprietary",
  "source": {
    "type": "local",
    "path": "../reference/streambox/aml_tvserver_streambox"
  },
  "patches": [
    "patches/sync-vout-mode-after-hdmitx.patch",
    "patches/streambox-video-over-osd.patch"
  ],
  "build": {
    "class": "make",
    "env": {
      "OUT_DIR": ".",
      "TVCONFIG_DIR": "{repo_root}/packages/aml-tvserver-streambox/sources/tvconfig",
      "TVSERVER_SERVICE": "{repo_root}/packages/aml-tvserver-streambox/files/tvserver.service",
      "CJSON_DIR": "{repo_root}/packages/aml-audio-hal/sources/utils/cJSON"
    }
  },
  "dependencies": {
    "recipes": [
      "android-liblog",
      "android-binder",
      "aml-audio-service"
    ],
    "native_tools": ["make"]
  },
  "outputs": [
    {
      "package": "aml-tvserver-streambox",
      "architecture": "arm64",
      "section": "utils",
      "description": "Amlogic TV Server Stream Box services, clients, and configuration.",
      "runtime_depends": [
        "android-binder",
        "aml-audio-service",
        "alsa-utils",
        "vfm-cap-modules",
        "zlib1g",
        "systemd"
      ],
      "files": [
        {"from": "usr/lib/libtv.so", "to": "/usr/lib/libtv.so"},
        {"from": "usr/lib/libtvclient.so", "to": "/usr/lib/libtvclient.so"},
        {"from": "usr/bin/tvservice", "to": "/usr/bin/tvservice", "mode": "0755"},
        {"from": "usr/bin/tvtest", "to": "/usr/bin/tvtest", "mode": "0755"},
        {"from": "usr/bin/hdmiin-demo", "to": "/usr/bin/hdmiin-demo", "mode": "0755"},
        {"from": "usr/bin/streambox-tv", "to": "/usr/bin/streambox-tv", "mode": "0755"},
        {"from": "etc/tvconfig", "to": "/etc/tvconfig"},
        {"from": "etc/streambox-tv", "to": "/etc/streambox-tv"},
        {"from": "vendor/etc/tvconfig", "to": "/vendor/etc/tvconfig"},
        {"from": "vendor/etc/streambox-tv", "to": "/vendor/etc/streambox-tv"},
        {"from": "usr/lib/systemd/system/tvserver.service", "to": "/usr/lib/systemd/system/tvserver.service", "mode": "0644"},
        {"from": "usr/lib/systemd/system/streambox-tv.service", "to": "/usr/lib/systemd/system/streambox-tv.service", "mode": "0644"}
      ],
      "sysroot_exports": [
        {"from": "usr/lib/libtv.so", "to": "/usr/lib/libtv.so"},
        {"from": "usr/lib/libtvclient.so", "to": "/usr/lib/libtvclient.so"},
        {"from": ".fenix-staging/usr/include/tvclient", "to": "/usr/include/tvclient"}
      ],
      "services": [
        {"unit": "tvserver.service", "enable": true},
        {"unit": "streambox-tv.service", "enable": true}
      ]
    }
  ]
}
