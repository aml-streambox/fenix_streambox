{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fenix.local/schemas/recipe-v1.schema.json",
  "title": "Fenix rootless source recipe",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "name",
    "version",
    "summary",
    "license",
    "source",
    "build",
    "dependencies",
    "outputs"
  ],
  "properties": {
    "schema": {
      "const": "fenix.recipe.v1"
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9+._-]*$"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "license": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "patches": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "default": []
    },
    "build": {
      "$ref": "#/$defs/build"
    },
    "dependencies": {
      "$ref": "#/$defs/dependencies"
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/output"
      }
    },
    "vendor_blob": {
      "$ref": "#/$defs/vendorBlob"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": {
        "type": ["string", "number", "boolean", "array", "object", "null"]
      },
      "default": {}
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "source": {
            "properties": {
              "type": {
                "const": "vendor-blob"
              }
            },
            "required": ["type"]
          }
        },
        "required": ["source"]
      },
      "then": {
        "required": ["vendor_blob"]
      }
    },
    {
      "if": {
        "properties": {
          "build": {
            "properties": {
              "class": {
                "const": "vendor-blob"
              }
            },
            "required": ["class"]
          }
        },
        "required": ["build"]
      },
      "then": {
        "required": ["vendor_blob"]
      }
    }
  ],
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {
          "enum": ["git", "tarball", "local", "vendor-blob"]
        },
        "uri": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64}$"
        },
        "subdir": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "git"
              }
            },
            "required": ["type"]
          },
          "then": {
            "required": ["uri", "revision"]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "tarball"
              }
            },
            "required": ["type"]
          },
          "then": {
            "required": ["uri", "sha256"]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "local"
              }
            },
            "required": ["type"]
          },
          "then": {
            "required": ["path"]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "vendor-blob"
              }
            },
            "required": ["type"]
          },
          "then": {
            "required": ["sha256"],
            "anyOf": [
              {
                "required": ["uri"]
              },
              {
                "required": ["path"]
              }
            ]
          }
        }
      ]
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class"],
      "properties": {
        "class": {
          "enum": ["make", "cmake", "meson", "autotools", "cargo", "kernel-module", "vendor-blob"]
        },
        "env": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {}
        },
        "configure_args": {
          "$ref": "#/$defs/stringList"
        },
        "build_args": {
          "$ref": "#/$defs/stringList"
        },
        "install_args": {
          "$ref": "#/$defs/stringList"
        },
        "targets": {
          "$ref": "#/$defs/stringList"
        },
        "install_target": {
          "type": "string",
          "minLength": 1
        },
        "offline": {
          "type": "boolean",
          "default": false
        },
        "locked": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "recipes": {
          "$ref": "#/$defs/stringList"
        },
        "distro_dev": {
          "$ref": "#/$defs/stringList"
        },
        "native_tools": {
          "$ref": "#/$defs/stringList"
        }
      },
      "default": {}
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package", "architecture", "description", "files"],
      "properties": {
        "package": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9+._-]*$"
        },
        "architecture": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "section": {
          "type": "string",
          "default": "misc"
        },
        "priority": {
          "type": "string",
          "default": "optional"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "runtime_depends": {
          "$ref": "#/$defs/stringList"
        },
        "files": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fileMapping"
          },
          "default": []
        },
        "sysroot_exports": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fileMapping"
          },
          "default": []
        },
        "services": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/service"
          },
          "default": []
        },
        "kernel_modules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/kernelModule"
          },
          "default": []
        }
      }
    },
    "fileMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to"],
      "properties": {
        "from": {
          "type": "string",
          "minLength": 1
        },
        "to": {
          "type": "string",
          "pattern": "^/.*"
        },
        "mode": {
          "type": "string",
          "pattern": "^[0-7]{3,4}$"
        }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unit"],
      "properties": {
        "unit": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.@:+-]+\\.(service|socket|timer|path|target)$"
        },
        "enable": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "kernelModule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^/lib/modules/.+\\.ko$"
        },
        "autoload": {
          "type": "string",
          "minLength": 1
        },
        "options": {
          "type": "string"
        },
        "udev_rules": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "default": []
        }
      }
    },
    "vendorBlob": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "origin",
        "version",
        "sha256",
        "license_category",
        "reason_source_unavailable",
        "replacement"
      ],
      "properties": {
        "origin": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64}$"
        },
        "license_category": {
          "type": "string",
          "minLength": 1
        },
        "reason_source_unavailable": {
          "type": "string",
          "minLength": 1
        },
        "replacement": {
          "type": "object",
          "additionalProperties": false,
          "required": ["owner", "status"],
          "properties": {
            "owner": {
              "type": "string",
              "minLength": 1
            },
            "status": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "stringList": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "default": []
    }
  }
}
