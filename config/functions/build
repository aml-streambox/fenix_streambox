# Functions:
# build_uboot
# build_linux
# build_linux_debs
# build_uboot_deb
# build_uboot_image
# clean_linux
# clean_uboot
# config_linux
# save_linux_config

linux_source_is_local() {
	[[ "$LINUX_SOURCE_URL" == /* ]]
}

## Build U-Boot
build_uboot() {
	ret=0

	if [ "$KHADAS_BOARD" == "Generic" ]; then
		warning_msg "Ignore u-boot build for generic configuration!"
		return
	fi

	if [ "$UBOOT" == "mainline" ] && [ "$KHADAS_BOARD" != "Edge2" ]; then
		rm -rf $BUILD/.stamps/u-boot-mainline/
		build_package "u-boot-mainline:target"

		return 0
	fi

	if [ "$UBOOT_GIT_BRANCH" == "" ]; then
		error_msg "'UBOOT_GIT_BRANCH' is empty!"
		return -1
	fi

	cd ${ROOT}
	if [ ! -d "$UBOOT_VENDOR_DIR"/.git ]; then
		# Check if source is a local path (starts with /)
		if [[ "$UBOOT_SOURCE_URL" == /* ]]; then
			info_msg "U-boot source is local path: '$UBOOT_SOURCE_URL'"
			if [ -d "$UBOOT_SOURCE_URL"/.git ]; then
				info_msg "Copying local u-boot repository to build directory..."
				cp -r "$UBOOT_SOURCE_URL" "$UBOOT_VENDOR_DIR"
				[ $? != 0 ] && error_msg "Failed to copy local u-boot" && return -1
			else
				error_msg "Local u-boot path '$UBOOT_SOURCE_URL' is not a git repository"
				return -1
			fi
		else
			info_msg "U-boot repository does not exist, clone u-boot repository('$UBOOT_GIT_BRANCH') from '$UBOOT_SOURCE_URL'..."
			## Clone u-boot from Khadas GitHub
			git clone $GIT_CLONE_OPTIONS $UBOOT_SOURCE_URL -b $UBOOT_GIT_BRANCH "$UBOOT_VENDOR_DIR"
			[ $? != 0 ] && error_msg "Failed to clone 'u-boot'" && return -1
		fi
	fi

	cd "$UBOOT_VENDOR_DIR"
	touch .scmversion

	# For local repos, re-sync from source on every build
	if [[ "$UBOOT_SOURCE_URL" == /* ]]; then
		info_msg "Re-syncing u-boot from local source: '$UBOOT_SOURCE_URL'..."
		# Fetch to a remote tracking ref, then reset to it
		git fetch --force "$UBOOT_SOURCE_URL" $UBOOT_GIT_BRANCH:refs/remotes/local_src/$UBOOT_GIT_BRANCH
		if [ $? -eq 0 ]; then
			git reset --hard refs/remotes/local_src/$UBOOT_GIT_BRANCH
		else
			error_msg "Failed to sync u-boot from local source"
			return -1
		fi
	fi

	if ! git branch | grep "^* $UBOOT_GIT_BRANCH$" > /dev/null; then
		if ! git branch | grep "^  $UBOOT_GIT_BRANCH$" > /dev/null; then
			# New branch? Try to fetch it (only for remote repos).
			if [[ "$UBOOT_SOURCE_URL" != /* ]]; then
				info_msg "Fetching '$UBOOT_GIT_BRANCH' from '$UBOOT_SOURCE_URL'..."
				git fetch origin $UBOOT_GIT_BRANCH:$UBOOT_GIT_BRANCH
			else
				error_msg "U-boot: Branch '$UBOOT_GIT_BRANCH' not found in local repo"
				return -1
			fi
		fi

		info_msg "U-boot: Switch to branch '$UBOOT_GIT_BRANCH'"
		make distclean
		# Check modifications
		check_modifications || {
			error_msg "U-boot: can't checkout to branch '$UBOOT_GIT_BRANCH', please commit your modifications and try again!"
			return -1
		}

		git checkout $UBOOT_GIT_BRANCH
		[ $? != 0 ] && error_msg "U-boot: Switch to branch '$UBOOT_GIT_BRANCH' failed." && return -1
	else
		info_msg "U-boot: Already on branch '$UBOOT_GIT_BRANCH'"
	fi

	# Update u-boot (skip for local repos)
	if [[ "$UBOOT_SOURCE_URL" != /* ]]; then
		update_git_repo "$PWD" "$UBOOT_GIT_BRANCH"
	fi

	info_msg "Build u-boot..."

	if [[ $(type -t uboot_custom_build) == function ]]; then
		export PATH=$UBOOT_COMPILER_PATH:$PATH
		export PATH=$UBOOT_COMPILER_PATH:$PATH
		export CROSS_COMPILE=$UBOOT_COMPILER
		uboot_custom_build
		export CROSS_COMPILE=
	else
		export PATH=$UBOOT_COMPILER_PATH:$PATH
		if [ "$UBOOT_FORCE_REBUILD" == "yes" ]; then
			info_msg "U-boot: Force cleaning..."
			make distclean
		fi
		rm -rf .config *.bin *.img
		make $UBOOT_DEFCONFIG
		make -j${NR_JOBS} CROSS_COMPILE="${CCACHE} ${UBOOT_COMPILER}"
	fi

	if [[ $(type -t uboot_custom_postprocess) == function ]]; then
		uboot_custom_postprocess
	fi

	ret=$?

	return $ret
}

## Build Linux
build_linux() {
	ret=0

#	if [ "$LINUX" == "mainline" ]; then
#		rm -rf $BUILD/.stamps/linux-mainline/
#		build_package "linux-mainline:target"
#		return 0
#	fi

	if [ "$LINUX_GIT_BRANCH" == "" ] || [ "$LINUX_DTB" == "" ]; then
		[ "$LINUX_GIT_BRANCH" == "" ] && error_msg "'LINUX_GIT_BRANCH' is empty!"
		[ "$LINUX_DTB" == "" ] && error_msg "'LINUX_DTB' is empty!"
		return -1
	fi

	cd ${ROOT}
	if linux_source_is_local; then
		if [ ! -d "$LINUX_SOURCE_URL"/.git ]; then
			error_msg "Local linux path '$LINUX_SOURCE_URL' is not a git repository"
			return -1
		fi

		LINUX_VENDOR_DIR=$(realpath "$LINUX_SOURCE_URL")
		LINUX_DIR=$LINUX_VENDOR_DIR
		info_msg "Using local linux source tree: '$LINUX_DIR'"
		info_msg "Skipping linux clone, checkout, and git update for local source"
	elif [ ! -d "$LINUX_VENDOR_DIR"/.git ]; then
		info_msg "Linux repository does not exist, clone linux repository('$LINUX_GIT_BRANCH') from '$LINUX_SOURCE_URL'..."
		## Clone linux from Khadas GitHub
		git clone $GIT_CLONE_OPTIONS $LINUX_SOURCE_URL -b $LINUX_GIT_BRANCH "$LINUX_VENDOR_DIR"
		[ $? != 0 ] && error_msg "Failed to clone 'linux'" && return -1
	fi

	if [ -n "$LINUX_COMMON_DRIVERS_GIT_BRANCH" ]; then
		if [ ! -d "$LINUX_COMMON_DRIVERS_DIR"/.git ]; then
			# Check if source is a local path (starts with /)
			if [[ "$LINUX_COMMON_DRIVERS_SOURCE_URL" == /* ]]; then
				info_msg "Linux common drivers source is local path: '$LINUX_COMMON_DRIVERS_SOURCE_URL'"
				if [ -d "$LINUX_COMMON_DRIVERS_SOURCE_URL"/.git ]; then
					info_msg "Copying local linux common drivers repository to build directory..."
					cp -r "$LINUX_COMMON_DRIVERS_SOURCE_URL" "$LINUX_COMMON_DRIVERS_DIR"
					[ $? != 0 ] && error_msg "Failed to copy local linux common drivers" && return -1
				else
					error_msg "Local linux common drivers path '$LINUX_COMMON_DRIVERS_SOURCE_URL' is not a git repository"
					return -1
				fi
			else
				info_msg "Linux common drivers repository does not exist, clone linux common drviers repository('$LINUX_COMMON_DRIVERS_GIT_BRANCH') from '$LINUX_COMMON_DRIVERS_SOURCE_URL'..."
				## Clone linux common drivers from Khadas GitHub
				git clone $GIT_CLONE_OPTIONS $LINUX_COMMON_DRIVERS_SOURCE_URL -b $LINUX_COMMON_DRIVERS_GIT_BRANCH "$LINUX_COMMON_DRIVERS_DIR"
				[ $? != 0 ] && error_msg "Failed to clone 'linux common drivers'" && return -1
			fi
		fi
	fi

	cd "$LINUX_VENDOR_DIR"
	if ! linux_source_is_local; then
		touch .scmversion
	fi

	if linux_source_is_local; then
		:
	elif ! git branch | grep "^* $LINUX_GIT_BRANCH$" > /dev/null; then
		if ! git branch | grep "^  $LINUX_GIT_BRANCH$" > /dev/null; then
			# New branch? Try to fetch it.
			info_msg "Fetching '$LINUX_GIT_BRANCH' from '$LINUX_SOURCE_URL'..."
			git fetch origin $LINUX_GIT_BRANCH:$LINUX_GIT_BRANCH
		fi

		info_msg "Linux: Switch to branch '$LINUX_GIT_BRANCH'"
		make ARCH=arm64 distclean

		# Walkaround for branch switch
		if [ -f drivers/gpu/arm/mali400/mali/__malidrv_build_info.c ]; then
			rm drivers/gpu/arm/mali400/mali/__malidrv_build_info.c
		fi

		# Check modifications
		check_modifications || {
			error_msg "Linux: can't checkout to branch '$LINUX_GIT_BRANCH', please commit your modifications and try again!"

			return -1
		}

		git checkout $LINUX_GIT_BRANCH
		[ $? != 0 ] && error_msg "Linux: Switch to branch '$LINUX_GIT_BRANCH' failed." && return -1
	else
		info_msg "Linux: Already on branch '$LINUX_GIT_BRANCH'"
	fi

	if [ -n "$LINUX_COMMON_DRIVERS_GIT_BRANCH" ]; then
		cd "$LINUX_COMMON_DRIVERS_DIR"
		# For local repos, re-sync from source on every build
		if [[ "$LINUX_COMMON_DRIVERS_SOURCE_URL" == /* ]]; then
			info_msg "Re-syncing linux common drivers from local source: '$LINUX_COMMON_DRIVERS_SOURCE_URL'..."
			# Fetch to a remote tracking ref, then reset to it
			git fetch --force "$LINUX_COMMON_DRIVERS_SOURCE_URL" $LINUX_COMMON_DRIVERS_GIT_BRANCH:refs/remotes/local_src/$LINUX_COMMON_DRIVERS_GIT_BRANCH
			if [ $? -eq 0 ]; then
				git reset --hard refs/remotes/local_src/$LINUX_COMMON_DRIVERS_GIT_BRANCH
			else
				error_msg "Failed to sync linux common drivers from local source"
				return -1
			fi
		fi
		# Need to fetch common drivers
		if ! git branch | grep "^* $LINUX_COMMON_DRIVERS_GIT_BRANCH$" > /dev/null; then
			if ! git branch | grep "^  $LINUX_COMMON_DRIVERS_GIT_BRANCH$" > /dev/null; then
				# New branch? Try to fetch it.
				info_msg "Fetching '$LINUX_COMMON_DRIVERS_GIT_BRANCH' from '$LINUX_COMMON_DRIVERS_SOURCE_URL'..."
				git fetch origin $LINUX_COMMON_DRIVERS_GIT_BRANCH:$LINUX_COMMON_DRIVERS_GIT_BRANCH
			fi

			info_msg "Linux common drivers: Switch to branch '$LINUX_COMMON_DRIVERS_GIT_BRANCH'"

			# Check modifications
			check_modifications || {
				error_msg "Linux common drivers: can't checkout to branch '$LINUX_COMMON_DRIVERS_GIT_BRANCH', please commit your modifications and try again!"
				return -1
			}

			git checkout $LINUX_COMMON_DRIVERS_GIT_BRANCH
			[ $? != 0 ] && error_msg "Linux common drivers: Switch to branch '$LINUX_COMMON_DRIVERS_GIT_BRANCH' failed." && return -1
		else
			info_msg "Linux common drivers: Already on branch '$LINUX_COMMON_DRIVERS_GIT_BRANCH'"
		fi
		cd - > /dev/null
	fi

	# Update linux
	if ! linux_source_is_local; then
		update_git_repo "$LINUX_VENDOR_DIR" "$LINUX_GIT_BRANCH"
	fi
	# Skip git pull for local common drivers repos
	if [ -n "$LINUX_COMMON_DRIVERS_GIT_BRANCH" ] && [[ "$LINUX_COMMON_DRIVERS_SOURCE_URL" != /* ]]; then
		update_git_repo "$LINUX_COMMON_DRIVERS_DIR" "$LINUX_COMMON_DRIVERS_GIT_BRANCH"
	fi

	# no need build just prepare
	[ ! "$BUILD_LINUX_NOOP" ] || return 0

	info_msg "Build linux..."
	echo "${KERNEL_COMPILER} $KERNEL_COMPILER_PATH"
	export PATH=$KERNEL_COMPILER_PATH:$PATH
	make ARCH=arm64 CROSS_COMPILE="${KERNEL_COMPILER}" $LINUX_DEFCONFIG CONFIG_SHELL="bash"
	# Merge config fragment if specified
	if [ -n "$LINUX_DEFCONFIG_FRAGMENT" ]; then
		FRAGMENT_FILE=""
		# Check if fragment is an absolute path
		if [ -f "$LINUX_DEFCONFIG_FRAGMENT" ]; then
			FRAGMENT_FILE="$LINUX_DEFCONFIG_FRAGMENT"
		# Check if fragment is in config/boards directory
		elif [ -f "$ROOT/config/boards/$LINUX_DEFCONFIG_FRAGMENT" ]; then
			FRAGMENT_FILE="$ROOT/config/boards/$LINUX_DEFCONFIG_FRAGMENT"
		# Check if fragment is in kernel source directory
		elif [ -f "$LINUX_VENDOR_DIR/$LINUX_DEFCONFIG_FRAGMENT" ]; then
			FRAGMENT_FILE="$LINUX_VENDOR_DIR/$LINUX_DEFCONFIG_FRAGMENT"
		fi
		if [ -n "$FRAGMENT_FILE" ] && [ -f "$FRAGMENT_FILE" ]; then
			info_msg "Merging config fragment: $FRAGMENT_FILE"
			cd "$LINUX_VENDOR_DIR"
			$LINUX_VENDOR_DIR/scripts/kconfig/merge_config.sh -m -O "$LINUX_VENDOR_DIR" "$LINUX_VENDOR_DIR/.config" "$FRAGMENT_FILE"
		else
			warning_msg "Config fragment not found: $LINUX_DEFCONFIG_FRAGMENT"
		fi
	fi
	if [ "${BUILD_LINUX_DTBS_ONLY:-no}" == "yes" ]; then
		make -j${NR_JOBS} ARCH=arm64 CROSS_COMPILE="${CCACHE} ${KERNEL_COMPILER}" dtbs $EXTRA_MAKE_ARGS CONFIG_SHELL="bash"
	else
		make -j${NR_JOBS} ARCH=arm64 CROSS_COMPILE="${CCACHE} ${KERNEL_COMPILER}" Image dtbs  modules $EXTRA_MAKE_ARGS CONFIG_SHELL="bash"
	fi
}

## Build Fenix-compatible linux debs from an already-built local tree
build_simple_linux_debs() {
	local kernel_release image_pkgname image_pkgdir dtb_pkgname dtb_pkgdir dtb dtb_alias

	info_msg "Build simple linux debs from local source..."

	cd "$LINUX_DIR"
	kernel_release=$(make -s ARCH=arm64 CROSS_COMPILE="${KERNEL_COMPILER}" kernelrelease)
	[ -n "$kernel_release" ] || {
		error_msg "Unable to determine kernel release"
		return -1
	}

	[ -f "$LINUX_DIR/arch/arm64/boot/Image" ] || {
		error_msg "Kernel Image not found: $LINUX_DIR/arch/arm64/boot/Image"
		return -1
	}
	[ -f "$LINUX_DTB" ] || {
		error_msg "Linux DTB not found: $LINUX_DTB"
		return -1
	}

	mkdir -p "$BUILD_DEBS/$VERSION/$KHADAS_BOARD" "$BUILD_IMAGES/.tmp"
	export PATH=$KERNEL_COMPILER_PATH:$PATH

	image_pkgname="${LINUX_IMAGE_DEB}_${VERSION}_${DISTRIB_ARCH}"
	image_pkgdir="$BUILD_IMAGES/.tmp/$image_pkgname"
	rm -rf "$image_pkgdir"
	mkdir -p "$image_pkgdir/boot" "$image_pkgdir/DEBIAN"
	cp "$LINUX_DIR/arch/arm64/boot/Image" "$image_pkgdir/boot/vmlinuz-$kernel_release"
	[ -f "$LINUX_DIR/System.map" ] && cp "$LINUX_DIR/System.map" "$image_pkgdir/boot/System.map-$kernel_release"
	[ -f "$LINUX_DIR/.config" ] && cp "$LINUX_DIR/.config" "$image_pkgdir/boot/config-$kernel_release"

	make -C "$LINUX_DIR" ARCH=arm64 CROSS_COMPILE="${KERNEL_COMPILER}" \
		INSTALL_MOD_PATH="$image_pkgdir" INSTALL_MOD_STRIP=1 modules_install
	rm -f "$image_pkgdir/lib/modules/$kernel_release/build" \
		"$image_pkgdir/lib/modules/$kernel_release/source"

	cat <<-EOF > "$image_pkgdir/DEBIAN/control"
	Package: $LINUX_IMAGE_DEB
	Version: $VERSION
	Architecture: $DISTRIB_ARCH
	Maintainer: khadas <hello@khadas.com>
	Installed-Size: 1
	Section: kernel
	Priority: optional
	Provides: linux-image
	Description: Linux kernel image $kernel_release
	 This package contains the Linux kernel and modules for Fenix images.
	EOF

	cat <<-EOF > "$image_pkgdir/DEBIAN/postinst"
	#!/bin/bash
	set -e
	export DEB_MAINT_PARAMS="\$*"
	export INITRD=Yes
	test -d /etc/kernel/postinst.d && run-parts --arg="$kernel_release" --arg="/boot/vmlinuz-$kernel_release" /etc/kernel/postinst.d
	ln -sf vmlinuz-$kernel_release /boot/Image 2> /dev/null || mv /boot/vmlinuz-$kernel_release /boot/Image
	exit 0
	EOF

	cat <<-EOF > "$image_pkgdir/DEBIAN/prerm"
	#!/bin/bash
	set -e
	export DEB_MAINT_PARAMS="\$*"
	export INITRD=Yes
	test -d /etc/kernel/prerm.d && run-parts --arg="$kernel_release" --arg="/boot/vmlinuz-$kernel_release" /etc/kernel/prerm.d
	exit 0
	EOF

	cat <<-EOF > "$image_pkgdir/DEBIAN/postrm"
	#!/bin/bash
	set -e
	export DEB_MAINT_PARAMS="\$*"
	export INITRD=Yes
	test -d /etc/kernel/postrm.d && run-parts --arg="$kernel_release" --arg="/boot/vmlinuz-$kernel_release" /etc/kernel/postrm.d
	exit 0
	EOF

	chmod 755 "$image_pkgdir/DEBIAN/postinst" "$image_pkgdir/DEBIAN/prerm" "$image_pkgdir/DEBIAN/postrm"
	fakeroot dpkg-deb -b -Zxz "$image_pkgdir" "$BUILD_DEBS/$VERSION/$KHADAS_BOARD/${image_pkgname}.deb"
	rm -rf "$image_pkgdir"

	dtb_pkgname="${LINUX_IMAGE_DEB/image/dtb}_${VERSION}_${DISTRIB_ARCH}"
	dtb_pkgdir="$BUILD_IMAGES/.tmp/$dtb_pkgname"
	rm -rf "$dtb_pkgdir"
	mkdir -p "$dtb_pkgdir/boot/dtb-$kernel_release/amlogic" "$dtb_pkgdir/DEBIAN"
	for dtb in "$LINUX_DIR"/arch/arm64/boot/dts/amlogic/amlogic-t7-a311d2-*.dtb; do
		[ -f "$dtb" ] || continue
		cp "$dtb" "$dtb_pkgdir/boot/dtb-$kernel_release/amlogic/"
	done
	for dtb_alias in $FENIX_SIMPLE_DTB_ALIASES; do
		cp "$LINUX_DTB" "$dtb_pkgdir/boot/dtb-$kernel_release/amlogic/$dtb_alias"
	done
	cp "$LINUX_DTB" "$dtb_pkgdir/boot/dtb-$kernel_release/$(basename "$LINUX_DTB")"

	cat <<-EOF > "$dtb_pkgdir/DEBIAN/control"
	Package: ${LINUX_IMAGE_DEB/image/dtb}
	Version: $VERSION
	Architecture: $DISTRIB_ARCH
	Maintainer: khadas <hello@khadas.com>
	Installed-Size: 1
	Section: kernel
	Priority: optional
	Provides: linux-dtb
	Description: Linux device tree blobs $kernel_release
	 This package contains device tree blobs for Fenix images.
	EOF

	cat <<-EOF > "$dtb_pkgdir/DEBIAN/postinst"
	#!/bin/bash
	set -e
	cd /boot
	ln -sfT dtb-$kernel_release dtb 2> /dev/null || mv dtb-$kernel_release dtb
	echo dtb-$kernel_release > /boot/.dtb.tmp
	exit 0
	EOF

	chmod 755 "$dtb_pkgdir/DEBIAN/postinst"
	fakeroot dpkg-deb -b -Zxz "$dtb_pkgdir" "$BUILD_DEBS/$VERSION/$KHADAS_BOARD/${dtb_pkgname}.deb"
	rm -rf "$dtb_pkgdir"
}

## Build linux debs
build_linux_debs() {

	# overload
	if [[ $(type -t ${FUNCNAME[0]}_) == function ]]; then
	    ${FUNCNAME[0]}_
	    return
	fi

	# Build linux debs
	info_msg "Build linux debs..."
	if [ "$FENIX_SIMPLE_KERNEL_DEB" == "yes" ]; then
		build_simple_linux_debs
		return
	fi

	cd $ROOT

	# Hack for deb builder. To pack what's missing in headers pack.
	if [ ! -f /tmp/headers-debian-byteshift.patch ]; then
		cp archives/patches/misc/headers-debian-byteshift.patch /tmp
	fi

	touch $LINUX_DIR/.scmversion

	export PATH=$KERNEL_COMPILER_PATH:$PATH
	make -j${NR_JOBS} -C $LINUX_DIR bindeb-pkg \
	    KDEB_PKGVERSION="$VERSION" LOCAL_VERSION="-${VENDOR,,}-${LINUX}" \
	    KBUILD_DEBARCH="$DISTRIB_ARCH" ARCH=arm64 DEBFULLNAME="Khadas" \
	    DEBEMAIL="hello@khadas.com" CROSS_COMPILE="${CCACHE} \
	    ${KERNEL_COMPILER}" CONFIG_SHELL="bash" KDEB_COMPRESS=xz

	mkdir -p "$BUILD_DEBS/$VERSION/$KHADAS_BOARD"

	mv $BUILD/*.deb $BUILD_DEBS/$VERSION/$KHADAS_BOARD
	rm -rf $BUILD/*.buildinfo $BUILD/*.changes
}

## Build u-boot deb
build_uboot_deb() {
	local pkgname="${LINUX_UBOOT_DEB}"
	local pkgdir="$BUILD_IMAGES/.tmp/${pkgname}_${VERSION}-${UBOOT_VER}_${DISTRIB_ARCH}"

	if [ "$KHADAS_BOARD" == "Generic" ]; then
		warning_msg "Ignore u-boot debian package build for generic configuration!"
		return
	fi

	rm -rf $pkgdir
	mkdir -p $pkgdir/usr/lib/u-boot $pkgdir/DEBIAN

	# Copy u-boot files
	local uboot_files=$UBOOT_IMAGE_FILES
	for file in $uboot_files; do
		if [ ! -f $UBOOT_IMAGE_DIR/$file ]; then
			error_msg "U-boot file '$file' not found!"
			return -1
		fi
		cp "$UBOOT_IMAGE_DIR/$file" "$pkgdir"/usr/lib/u-boot
	done

	# For amlogic platform, we need to update the dtb for u-boot
	# Only for vendor u-boot & kernel
	if [ "$VENDOR" == "Amlogic" ] && [ "$LINUX" != "mainline" ]; then
		cp "$LINUX_DTB" "$pkgdir"/usr/lib/u-boot/dtb.img
	fi

	cat <<-EOF > $pkgdir/usr/lib/u-boot/platform_install.sh
	DIR=/usr/lib/u-boot
	$(declare -f write_uboot_platform)
	$(declare -f write_uboot_platform_ext)
	$(declare -f setup_write_uboot_platform)
	EOF

	# Set up control file
	cat <<-EOF > $pkgdir/DEBIAN/control
	Package: $pkgname
	Version: $VERSION-$UBOOT_VER
	Architecture: $DISTRIB_ARCH
	Maintainer: khadas <hello@khadas.com>
	Installed-Size: 1
	Section: kernel
	Priority: optional
	Provides: fenix-u-boot
	EOF

	if [ "$VENDOR" == "Amlogic" ]; then
		cat <<-EOF >> $pkgdir/DEBIAN/control
		Replaces: fenix-u-boot, linux-u-boot-vim1, linux-u-boot-vim2, linux-u-boot-vim3, linux-u-boot-vim1-mainline, linux-u-boot-vim1-vendor, linux-u-boot-vim2-mainline, linux-u-boot-vim2-vendor, linux-u-boot-vim3-mainline, linux-u-boot-vim3-vendor, linux-u-boot-vim3l-mainline, linux-u-boot-vim3l-vendor
		EOF
	else
		cat <<-EOF >> $pkgdir/DEBIAN/control
		Replaces: fenix-u-boot, linux-u-boot-edge-mainline, linux-u-boot-edge-vendor
		EOF
	fi

	cat <<-EOF >> $pkgdir/DEBIAN/control
	Description: U-boot $UBOOT_VER
	EOF

	# Set up postinst file
	cat <<-EOF > $pkgdir/DEBIAN/postinst
	#!/bin/bash

	# Exit if we are running chroot
	if [ "\$(stat -c %d:%i /)" != "\$(stat -c %d:%i /proc/1/root/.)" ]; then exit 0; fi

	source /usr/lib/u-boot/platform_install.sh
	source /etc/fenix-release
	[[ \$(type -t setup_write_uboot_platform) == function ]] && setup_write_uboot_platform
	EOF

	if [ "$VENDOR" == "Amlogic" ]; then
		cat <<-EOF >> $pkgdir/DEBIAN/postinst
		if [[ \$DEVICE = VENDOR ]]; then
			echo "Updating dtb for u-boot ..."
			[ -c /dev/dtb -a -f /usr/lib/u-boot/dtb.img ] && dd if=/usr/lib/u-boot/dtb.img of=/dev/dtb > /dev/null 2>&1
			echo "Updating u-boot on /dev/mmcblk0 (eMMC)"
			write_uboot_platform_ext \$DIR
			echo "Reseting u-boot environment variables ..."
			[ -b /dev/env ] && dd if=/dev/zero of=/dev/env bs=1M count=1 > /dev/null 2>&1
			[ -b /dev/mmcblk0p3 ] && dd if=/dev/zero of=/dev/mmcblk0p3 bs=1M count=1 > /dev/null 2>&1
			sync
		else
			if [[ -b \$DEVICE ]]; then
				echo "Updating u-boot on \$DEVICE"
				write_uboot_platform \$DIR \$DEVICE
				echo "Reseting u-boot environment variables ..."
				[ -b /dev/env ] && dd if=/dev/zero of=/dev/env bs=1M count=1 > /dev/null 2>&1
				sync
			else
				echo "Device \$DEVICE does not exist, skipping"
			fi
		fi

		exit 0
		EOF
	else
		cat <<-EOF >> $pkgdir/DEBIAN/postinst
		if [[ \$DEVICE = VENDOR ]]; then
			echo "Updating u-boot on /dev/mmcblk0 (eMMC)"
			write_uboot_platform_ext \$DIR
			sync
		else
			if [[ -b \$DEVICE ]]; then
				echo "Updating u-boot on \$DEVICE"
				write_uboot_platform \$DIR \$DEVICE
				sync
			else
				echo "Device \$DEVICE does not exist, skipping"
			fi
		fi
		exit 0
		EOF
	fi

	chmod 755 $pkgdir/DEBIAN/postinst

	cat <<-EOF > $pkgdir/DEBIAN/prerm
	#!/bin/bash
	rm -rf /usr/lib/u-boot/.UBOOT-NEED-UPDATE
	EOF

	chmod 755 $pkgdir/DEBIAN/prerm

	# Create board deb file
	info_msg "Building package: $pkgname"
	fakeroot dpkg-deb -b -Zxz $pkgdir ${pkgdir}.deb
	mkdir -p $BUILD_DEBS/$VERSION/$KHADAS_BOARD
	cp ${pkgdir}.deb $BUILD_DEBS/$VERSION/$KHADAS_BOARD
	# Cleanup
	rm -rf ${pkgdir}.deb
	rm -rf $pkgdir
}

# Clean linux
clean_linux() {
	for LINUX_DIR in $LINUX_DIR; do break; done
	info_msg "Clean linux..."
	[ -e "$LINUX_DIR/Makefile" ] || return 0
	export PATH=$KERNEL_COMPILER_PATH:$PATH
	make ARCH=arm64 distclean -C"$LINUX_DIR"
}

# Clean u-boot
clean_uboot() {
	for UBOOT_DIR in $UBOOT_DIR; do break; done
	info_msg "Clean u-boot..."
	[ -e "$UBOOT_DIR/Makefile" ] || return 0
	make distclean -C"$UBOOT_DIR"
}

# Config linux
config_linux() {
	for LINUX_DIR in $LINUX_DIR; do break; done
	info_msg "Config linux..."
	[ -e "$LINUX_DIR/Makefile" ] || {
		BUILD_LINUX_NOOP=1
		build_linux
		for LINUX_DIR in $LINUX_DIR; do break; done
	}

	export PATH=$KERNEL_COMPILER_PATH:$PATH
#	if [ "$LINUX" == "mainline" ]; then
#		cp $PKGS_DIR/linux-mainline/configs/${KHADAS_BOARD}.config "$LINUX_DIR"/.config
#	else
		make ARCH=arm64 CROSS_COMPILE=${KERNEL_COMPILER} $LINUX_DEFCONFIG -C"$LINUX_DIR"
#	fi

	make ARCH=arm64 CROSS_COMPILE=${KERNEL_COMPILER} menuconfig -C"$LINUX_DIR"
}

# Save linux config
save_linux_config() {
	for LINUX_DIR in $LINUX_DIR; do break; done
	info_msg "Save linux config..."
	[ -e "$LINUX_DIR/Makefile" ] || {
		error_msg "Need prepare linux before save config (make kernel-saveconfig) "
		return 1
	}

	export PATH=$KERNEL_COMPILER_PATH:$PATH
#	if [ "$LINUX" == "mainline" ]; then
#		cp "$LINUX_DIR"/.config $PKGS_DIR/linux-mainline/configs/${KHADAS_BOARD}.config
#	else
		make ARCH=arm64 CROSS_COMPILE=${KERNEL_COMPILER} savedefconfig -C"$LINUX_DIR"
		mv "$LINUX_DIR"/defconfig $LINUX_DEFCONFIG_DIR/$LINUX_DEFCONFIG
#	fi
}
