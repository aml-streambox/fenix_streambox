# TVPRO Linux 7.1 bring-up uses a board-focused kernel instead of arm64's
# broad distro defconfig. Keep Meson/Amlogic display, Panfrost, serial, MMC,
# and Ethernet paths; drop unrelated ARM64 platform families and heavyweight
# modules that cannot be used by the current TVPRO EMMC validation image.

CONFIG_ARCH_MESON=y
# CONFIG_ARCH_ACTIONS is not set
# CONFIG_ARCH_AIROHA is not set
# CONFIG_ARCH_SUNXI is not set
# CONFIG_ARCH_ALPINE is not set
# CONFIG_ARCH_APPLE is not set
# CONFIG_ARCH_ARTPEC is not set
# CONFIG_ARCH_AXIADO is not set
# CONFIG_ARCH_BCM is not set
# CONFIG_ARCH_BCM2835 is not set
# CONFIG_ARCH_BCM_IPROC is not set
# CONFIG_ARCH_BCMBCA is not set
# CONFIG_ARCH_BRCMSTB is not set
# CONFIG_ARCH_BERLIN is not set
# CONFIG_ARCH_BLAIZE is not set
# CONFIG_ARCH_BST is not set
# CONFIG_ARCH_CIX is not set
# CONFIG_ARCH_EXYNOS is not set
# CONFIG_ARCH_SPARX5 is not set
# CONFIG_ARCH_K3 is not set
# CONFIG_ARCH_LG1K is not set
# CONFIG_ARCH_HISI is not set
# CONFIG_ARCH_KEEMBAY is not set
# CONFIG_ARCH_MEDIATEK is not set
# CONFIG_ARCH_MICROCHIP is not set
# CONFIG_ARCH_MVEBU is not set
# CONFIG_ARCH_NXP is not set
# CONFIG_ARCH_LAYERSCAPE is not set
# CONFIG_ARCH_MXC is not set
# CONFIG_ARCH_S32 is not set
# CONFIG_ARCH_MA35 is not set
# CONFIG_ARCH_NPCM is not set
# CONFIG_ARCH_QCOM is not set
# CONFIG_ARCH_REALTEK is not set
# CONFIG_ARCH_RENESAS is not set
# CONFIG_ARCH_ROCKCHIP is not set
# CONFIG_ARCH_SEATTLE is not set
# CONFIG_ARCH_INTEL_SOCFPGA is not set
# CONFIG_ARCH_SOPHGO is not set
# CONFIG_ARCH_STM32 is not set
# CONFIG_ARCH_SYNQUACER is not set
# CONFIG_ARCH_TEGRA is not set
# CONFIG_ARCH_TESLA_FSD is not set
# CONFIG_ARCH_SPRD is not set
# CONFIG_ARCH_THUNDER is not set
# CONFIG_ARCH_THUNDER2 is not set
# CONFIG_ARCH_UNIPHIER is not set
# CONFIG_ARCH_VEXPRESS is not set
# CONFIG_ARCH_VISCONTI is not set
# CONFIG_ARCH_XGENE is not set
# CONFIG_ARCH_ZYNQMP is not set

# TVPRO boots with DT, not ACPI/virtualization/PCI expansion.
# CONFIG_ACPI is not set
# CONFIG_XEN is not set
# CONFIG_VIRTUALIZATION is not set
# CONFIG_KVM is not set
# CONFIG_PCI is not set

# Keep network/storage server stacks small, but retain desktop filesystem and
# confinement features needed by GNOME portals and Ubuntu snap packages.
# CONFIG_BLK_DEV_NBD is not set
# CONFIG_NVME_CORE is not set
# CONFIG_BLK_DEV_NVME is not set
# CONFIG_MD is not set
# CONFIG_BLK_DEV_MD is not set
# CONFIG_BLK_DEV_DM is not set
# CONFIG_BTRFS_FS is not set
# CONFIG_NFS_FS is not set
# CONFIG_NFSD is not set
# CONFIG_CIFS is not set
# CONFIG_SMB_SERVER is not set
CONFIG_FUSE_FS=m
CONFIG_OVERLAY_FS=m
CONFIG_SQUASHFS_XATTR=y
CONFIG_SQUASHFS_LZ4=y
CONFIG_SQUASHFS_LZO=y
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_SECURITY_NETWORK=y
CONFIG_SECURITY_PATH=y
CONFIG_SECURITY_APPARMOR=y
CONFIG_SECURITY_APPARMOR_HASH=y
CONFIG_SECURITY_APPARMOR_HASH_DEFAULT=y
CONFIG_DEFAULT_SECURITY_APPARMOR=y
CONFIG_LSM="landlock,lockdown,yama,loadpin,safesetid,ipe,apparmor,bpf"

# Required TVPRO 7.1 base/display paths.
CONFIG_SERIAL_MESON=y
CONFIG_SERIAL_MESON_CONSOLE=y
CONFIG_MMC_MESON_GX=y
CONFIG_DWMAC_MESON=m
CONFIG_DRM_PANFROST=m
CONFIG_DRM_CLIENT_SELECTION=m
CONFIG_DRM_CLIENT_SETUP=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_DRM_CLIENT_DEFAULT="fbdev"
CONFIG_FRAMEBUFFER_CONSOLE=y
# Use the vendor T7 clock-measure provider; the generic Meson driver
# registers the same platform-driver name but has no T7 match.
# CONFIG_MESON_CLK_MEASURE is not set
CONFIG_AMLOGIC_COMMON_CLK=y
CONFIG_AMLOGIC_COMMON_CLK_MESON_REGMAP=y
CONFIG_AMLOGIC_COMMON_CLK_MESON_DUALDIV=y
CONFIG_AMLOGIC_COMMON_CLK_MESON_MPLL=y
CONFIG_AMLOGIC_COMMON_CLK_MESON_PLL=y
CONFIG_AMLOGIC_COMMON_CLK_MESON_CPU_DYNDIV=y
CONFIG_AMLOGIC_COMMON_CLK_MESON_VID_PLL_DIV=y
CONFIG_AMLOGIC_COMMON_CLK_T7=m
CONFIG_AMLOGIC_MESON_CLK_MEASURE=y
CONFIG_AMLOGIC_COMMON_CLK_T7_DISPLAY=y
CONFIG_AMLOGIC_MEDIA_CODEC_MM=y
CONFIG_AMLOGIC_MEDIA_MULTI_DEC=y
CONFIG_DMABUF_HEAPS=y
CONFIG_DMABUF_HEAPS_SYSTEM=y
CONFIG_AMLOGIC_HEAP_CODEC_MM=y
CONFIG_AMLOGIC_TEE=m

# Vendor V4L decoder bring-up.
CONFIG_AMLOGIC_MEDIA_V4L_DEC=m
CONFIG_AMLOGIC_MEDIA_VDEC_MPEG12=m
CONFIG_AMLOGIC_MEDIA_VDEC_MPEG2_MULTI=m
CONFIG_AMLOGIC_MEDIA_VDEC_MPEG4=m
CONFIG_AMLOGIC_MEDIA_VDEC_MPEG4_MULTI=m
CONFIG_AMLOGIC_MEDIA_VDEC_VC1=m
CONFIG_AMLOGIC_MEDIA_VDEC_H264=m
CONFIG_AMLOGIC_MEDIA_VDEC_H264_MULTI=m
CONFIG_AMLOGIC_MEDIA_VDEC_H264_MVC=m
CONFIG_AMLOGIC_MEDIA_VDEC_H265=m
CONFIG_AMLOGIC_MEDIA_VDEC_VP9=m
CONFIG_AMLOGIC_MEDIA_VDEC_MJPEG=m
CONFIG_AMLOGIC_MEDIA_VDEC_MJPEG_MULTI=m
CONFIG_AMLOGIC_MEDIA_VDEC_REAL=m
CONFIG_AMLOGIC_MEDIA_VDEC_AVS=m
CONFIG_AMLOGIC_MEDIA_VDEC_AVS_MULTI=m
CONFIG_AMLOGIC_MEDIA_VDEC_AVS2=m
CONFIG_AMLOGIC_MEDIA_VDEC_AV1=m
CONFIG_AMLOGIC_MEDIA_VDEC_AVS3=m
CONFIG_AMLOGIC_MEDIA_VDEC_VP9_FB=m
CONFIG_AMLOGIC_MEDIA_VDEC_H265_FB=m
CONFIG_AMLOGIC_MEDIA_VDEC_AV1_FB=m
CONFIG_AMLOGIC_MEDIA_VDEC_AV1_T5D=m
CONFIG_AMLOGIC_MEDIA_VDEC_AVS2_FB=m
# CONFIG_AMLOGIC_MEDIA_VENC_H264 is not set
# CONFIG_AMLOGIC_MEDIA_VENC_H265 is not set
CONFIG_AMLOGIC_MEDIA_VENC_MULTI=m
CONFIG_AMLOGIC_MEDIA_VENC_JPEG=m
# CONFIG_AMLOGIC_MEDIA_VENC_MEMALLOC is not set
CONFIG_AMLOGIC_MEDIA_VENC_COMMON=m

CONFIG_UIO=m
CONFIG_VIDEOBUF2_DMA_SG=m
CONFIG_AMLOGIC_UVM_CORE=y
CONFIG_AMLOGIC_UVM_ALLOCATOR=y
CONFIG_AMLOGIC_MEDIA_GE2D=m
CONFIG_AMLOGIC_MEDIA_RESMANAGE=m
# CONFIG_AMLOGIC_MEDIA_DEINTERLACE is not set
CONFIG_AMLOGIC_DRM=m
# TVPRO is not an Amlogic zapper profile; match the 5.15 TVPRO build.
# CONFIG_AMLOGIC_ZAPPER_NET_CUT is not set
# CONFIG_AMLOGIC_ZAPPER_CUT is not set
# CONFIG_AMLOGIC_ZAPPER_CUT_C1A is not set
# CONFIG_AMLOGIC_REMOVE_OLD is not set
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDERFS=y
CONFIG_ANDROID_BINDER_DEVICES="binder,hwbinder,vndbinder"
